{
  "name": "thira-ui",
  "version": "0.8.0",
  "description": "A minimal, accessible React component library built on Base UI primitives and modern CSS.",
  "license": "MIT",
  "author": "Thiraphat Phutson",
  "homepage": "https://thiraphat-ps-dev.github.io/thira-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiraphat-ps-dev/thira-ui.git"
  },
  "bugs": {
    "url": "https://github.com/thiraphat-ps-dev/thira-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "base-ui",
    "css-variables",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/thira-ui.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "thira-icons": "^0.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "thira-sans": "^0.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
